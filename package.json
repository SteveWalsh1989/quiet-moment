{
  "name": "quiet-moment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run build",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "vue": "3.5.45",
    "@vercel/analytics": "2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.1",
    "prettier": "3.10.0",
    "tailwindcss": "3.4.16",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
